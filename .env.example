# ==============================================================================
# COMRADES LEGACY - TASK OPERATIONS ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env before booting the application:
#   cp .env.example .env
#
# DO NOT commit real secrets, passwords, or production credentials to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma ORM & MySQL)
# ------------------------------------------------------------------------------
# Format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
#
# HOSTINGER DEPLOYMENT NOTE:
# When hosted directly inside the Hostinger Node.js environment, the Node application
# and the MySQL daemon reside on the same server instance. Use 127.0.0.1 (localhost):
#
#   DATABASE_URL="mysql://<user>:<password>@127.0.0.1:3306/<database_name>"
#
# LOCAL DEVELOPMENT NOTE:
# When connecting from your local workstation to a remote Hostinger MySQL server,
# you must whitelist your external IP under Hostinger hPanel -> Remote MySQL and
# substitute the host with your server's assigned hostname or public IP address:
#
#   DATABASE_URL="mysql://<user>:<password>@srvXXXX.hstgr.io:3306/<database_name>"
# ------------------------------------------------------------------------------
DATABASE_URL="mysql://<db_user>:<db_password>@127.0.0.1:3306/<db_name>"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH.JS (AUTH.JS v5) SECURITY KEYS
# ------------------------------------------------------------------------------
# Generate a cryptographic 32-byte secret using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
AUTH_SECRET="your_generated_32_byte_hex_secret_here"
NEXTAUTH_SECRET="your_generated_32_byte_hex_secret_here"

# ------------------------------------------------------------------------------
# 3. CANONICAL APP URL
# ------------------------------------------------------------------------------
# Development: http://localhost:3000
# Production:  https://tasks.yourclothingbrand.com (or your Hostinger domain)
# ------------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
